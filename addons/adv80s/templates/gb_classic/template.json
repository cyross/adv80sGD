{
  "template_version": 1,
  "id": "gb_classic",
  "name": "GB クラシック",
  "extends": "pc98_classic",
  "display": {
    "preset": "GB",
    "scale": "integer"
  },
  "fonts": {
    "main": [
      {
        "asset": "pixelmplus10",
        "size": 10,
        "line_height": 11
      }
    ]
  },
  "layout": {
    "regions": {
      "picture": {
        "rect": [4, 4, 84, 93]
      },
      "commands": {
        "rect": [90, 4, 66, 93],
        "window": "main"
      },
      "message": {
        "rect": [4, 99, 152, 41],
        "window": "main"
      },
      "input": {
        "visible": false
      }
    },
    "named": {
      "fullscreen_cg": {
        "regions": {
          "picture": {
            "rect": [0, 0, 160, 144]
          },
          "message": {
            "visible": false
          },
          "input": {
            "visible": false
          },
          "commands": {
            "visible": false
          }
        }
      }
    },
    "background": 3
  },
  "inputs": {
    "enabled": [
      "select"
    ],
    "parser_profile": "ja",
    "command_columns": 1
  },
  "text": {
    "color": 0,
    "name_color": 1
  },
  "ui": {
    "highlight": 2,
    "window_skin": {
      "type": "nine_patch",
      "image": "frame_gb_classic",
      "margins": [4, 4, 4, 4]
    },
    "window_padding": [6, 3]
  },
  "assets": {
    "root": "assets/",
    "manifest": "manifest.json"
  }
}
