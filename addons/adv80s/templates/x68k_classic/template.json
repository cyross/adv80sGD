{
  "template_version": 1,
  "id": "x68k_classic",
  "name": "X68K クラシック",
  "extends": "pc98_classic",
  "display": {
    "preset": "X68K",
    "scale": "integer"
  },
  "palette": {
    "source": "colors",
    "colors": [
      "#000000",
      "#0000ff",
      "#ff0000",
      "#ff00ff",
      "#00ff00",
      "#00ffff",
      "#ffff00",
      "#ffffff"
    ]
  },
  "fonts": {
    "main": [
      {
        "asset": "dot16",
        "size": 16
      },
      {
        "asset": "pixelmplus12",
        "size": 12,
        "line_height": 16
      }
    ]
  },
  "layout": {
    "regions": {
      "picture": {
        "rect": [10, 5, 748, 360]
      },
      "message": {
        "rect": [10, 370, 520, 104],
        "window": "main"
      },
      "input": {
        "rect": [10, 479, 520, 28]
      },
      "commands": {
        "rect": [535, 370, 223, 137],
        "window": "main"
      }
    },
    "named": {
      "fullscreen_cg": {
        "regions": {
          "picture": {
            "rect": [0, 0, 768, 512]
          },
          "message": {
            "visible": false
          },
          "input": {
            "visible": false
          },
          "commands": {
            "visible": false
          }
        }
      }
    },
    "background": 0
  },
  "text": {
    "color": 7,
    "name_color": 6
  },
  "ui": {
    "highlight": 1,
    "window_skin": {
      "type": "box",
      "border": 1,
      "pal": 7,
      "fill": 0
    },
    "cursors": {
      "default": {
        "image": "cursor_arrow",
        "hotspot": [0, 0]
      },
      "look": {
        "image": "cursor_look",
        "hotspot": [5, 6]
      },
      "talk": {
        "image": "cursor_talk",
        "hotspot": [6, 5]
      },
      "take": {
        "image": "cursor_hand",
        "hotspot": [5, 0]
      },
      "use": {
        "image": "cursor_hand",
        "hotspot": [5, 0]
      },
      "exit": {
        "image": "cursor_exit",
        "hotspot": [13, 8]
      },
      "wait": {
        "image": "cursor_wait",
        "hotspot": [6, 7]
      },
      "next": {
        "image": "cursor_next",
        "hotspot": [5, 7]
      },
      "text": "ibeam"
    }
  },
  "assets": {
    "root": "assets/",
    "manifest": "manifest.json"
  }
}
