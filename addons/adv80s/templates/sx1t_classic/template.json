{
  "template_version": 1,
  "id": "sx1t_classic",
  "name": "SX1T クラシック",
  "extends": "pc98_classic",
  "display": {
    "preset": "SX1T",
    "scale": "integer"
  },
  "fonts": {
    "main": [
      {
        "asset": "dot16",
        "size": 16
      },
      {
        "asset": "pixelmplus12",
        "size": 12,
        "line_height": 16
      }
    ]
  },
  "layout": {
    "regions": {
      "picture": {
        "rect": [8, 4, 624, 268]
      },
      "message": {
        "rect": [8, 276, 434, 88],
