{
  "template_version": 1,
  "id": "ftns_classic",
  "name": "FTNS クラシック",
  "extends": "pc98_classic",
  "display": {
    "preset": "FTNS",
    "scale": "integer"
  },
  "palette": {
    "source": "colors",
    "colors": [
      "#000000",
      "#0000ff",
      "#ff0000",
      "#ff00ff",
      "#00ff00",
      "#00ffff",
      "#ffff00",
      "#ffffff"
    ]
  },
  "fonts": {
    "main": [
      {
        "asset": "dot16",
        "size": 16
      },
      {
        "asset": "pixelmplus12",
        "size": 12,
        "line_height": 16
      }
    ]
  },
  "layout": {
    "regions": {
      "picture": {
        "rect": [8, 5, 624, 346]
      },
      "message": {
        "rect": [8, 355, 434, 88],
        "window": "main"
      },
      "input": {
        "rect": [8, 447, 434, 28]
      },
      "commands": {
        "rect": [446, 355, 186, 120],
        "window": "main"
      }
    },
    "named": {
      "fullscreen_cg": {
        "regions": {
          "picture": {
            "rect": [0, 0, 640, 480]
          },
          "message": {
            "visible": false
          },
          "input": {
            "visible": false
          },
          "commands": {
            "visible": false
          }
        }
      }
    },
    "background": 0
  },
  "text": {
    "color": 7,
    "name_color": 6
  },
  "ui": {
    "highlight": 1,
    "window_skin": {
      "type": "box",
      "border": 1,
      "pal": 7,
      "fill": 0
    }
  },
  "assets": {
    "root": "assets/",
    "manifest": "manifest.json"
  }
}
