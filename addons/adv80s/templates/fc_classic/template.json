{
  "template_version": 1,
  "id": "fc_classic",
  "name": "FC クラシック",
  "extends": "pc98_classic",
  "display": {
    "preset": "FC",
    "scale": "integer"
  },
  "palette": {
    "source": "colors",
    "colors": [
      "#000000",
      "#0000ff",
      "#ff0000",
      "#ff00ff",
      "#00ff00",
      "#00ffff",
      "#ffff00",
      "#ffffff"
    ]
  },
  "fonts": {
    "main": [
      {
        "asset": "pixelmplus10",
        "size": 10,
        "line_height": 12
      }
    ]
  },
  "layout": {
    "regions": {
      "picture": {
        "rect": [4, 12, 169, 170]
      },
      "commands": {
        "rect": [175, 12, 77, 170],
        "window": "main"
      },
      "message": {
        "rect": [4, 184, 248, 44],
        "window": "main"
      },
      "input": {
        "visible": false
      }
    },
    "named": {
      "fullscreen_cg": {
        "regions": {
          "picture": {
            "rect": [0, 8, 256, 224]
          },
          "message": {
            "visible": false
          },
          "input": {
            "visible": false
          },
          "commands": {
            "visible": false
          }
        }
      }
    },
    "background": 0
  },
  "inputs": {
    "enabled": [
      "select"
    ],
    "parser_profile": "ja",
    "command_columns": 1
  },
  "text": {
    "color": 7,
    "name_color": 6
  },
  "ui": {
    "highlight": 1,
    "window_skin": {
      "type": "nine_patch",
      "image": "frame_fc_classic",
      "margins": [4, 4, 4, 4]
    },
    "window_padding": [8, 6]
  },
  "assets": {
    "root": "assets/",
    "manifest": "manifest.json"
  }
}
