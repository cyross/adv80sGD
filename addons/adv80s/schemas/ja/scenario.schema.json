{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/scenario.schema.json",
  "title": "adv80s シナリオ",
  "description": "JSONシナリオ（5.2、5.7、5.8）",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "scenario_version": {
      "type": "integer"
    },
    "start": {
      "type": "string",
      "description": "開始シーンID"
    },
    "scene": {
      "type": "string",
      "description": "シーン1つだけのファイルのときのシーンID"
    },
    "name": {
      "type": "string",
      "description": "表示名"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "variant": {
                    "type": "string"
                  },
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  },
                  "when": {
                    "$ref": "#/definitions/condition"
                  }
                }
              }
            ]
          }
        }
      ],
      "description": "背景の画像ID（またはパス）。配列なら when に合う画像を順に重ねる"
    },
    "image_transition": {
      "description": "配列の image が条件で変わったときの切り替え演出（既定 cut）"
    },
    "first": {
      "$ref": "#/definitions/step",
      "description": "初めて入ったときの手順"
    },
    "enter": {
      "$ref": "#/definitions/step",
      "description": "入ったときの手順（first があれば2回目以降）"
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "コマンド入力で認識する呼び名"
          },
          "label": {
            "type": "string",
            "description": "コマンド選択に出す名前"
          },
          "region": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, 幅, 高さ]（元の解像度のピクセル）"
          },
          "sprite": {
            "type": "string",
            "description": "結び付けるスプライトID（見えている範囲が調べられる場所になる）"
          },
          "cursor": {
            "type": "string",
            "description": "マウスを重ねたときのカーソルの種類"
          },
          "character": {
            "type": "string",
            "description": "人物として扱うときの話者ID"
          },
          "when": {
            "$ref": "#/definitions/condition",
            "description": "表示する条件"
          },
          "on": {
            "type": "object",
            "description": "動詞ごとの反応。\"USE+door\" のように with の対象を指定できる",
            "patternProperties": {
              "^[A-Z][A-Z0-9_]*(\\+[^+]+)?$": {
                "$ref": "#/definitions/step"
              }
            },
            "additionalProperties": false
          },
          "ext": {
            "type": "object",
            "description": "拡張領域。中身は自由"
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^x\\.": {
            "description": "自作の項目（x.名前）"
          }
        }
      },
      "description": "シーンの中の物や人物"
    },
    "exits": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "label": {
                "type": "string"
              },
              "when": {
                "$ref": "#/definitions/condition"
              },
              "on": {
                "type": "object",
                "description": "動詞ごとの反応。\"USE+door\" のように with の対象を指定できる",
                "patternProperties": {
                  "^[A-Z][A-Z0-9_]*(\\+[^+]+)?$": {
                    "$ref": "#/definitions/step"
                  }
                },
                "additionalProperties": false
              },
              "region": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4,
