        "properties": {
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "anchor": {
            "type": "string"
          },
          "z": {
            "type": "integer"
          },
          "scale": {
            "anyOf": [
              {
                "type": "number"
              },
