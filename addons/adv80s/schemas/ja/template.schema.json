{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/template.schema.json",
  "title": "adv80s 画面テンプレート",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "template_version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "description": "テンプレートID"
    },
    "name": {
      "type": "string",
      "description": "表示名"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ],
      "description": "継承元のテンプレートID"
    },
    "display": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "description": "画面プリセット（機種ID または 機種ID.モード名）"
        },
        "scale": {
          "enum": [
            "integer",
            "fit",
            "none"
          ]
        },
        "aspect_correction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "preset",
            "colors"
          ]
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#?[0-9a-fA-F]{6}$"
          }
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/definitions/font_entry"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/definitions/font_entry"
            },
            "minItems": 1
          }
        ]
      },
      "description": "フォント（main、readable）。候補の配列で書くと、素材が見つかった最初のものを使う"
    },
    "layout": {
      "type": "object",
      "properties": {
        "background": {
          "type": "integer",
          "description": "背景のパレット番号"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "画像の層（奥から順）"
        },
        "screen_layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "画面全体のスプライトの層。名前が back で始まる層は絵の窓より奥、ほかは窓より前（既定 [\"back\", \"front\"]）"
        },
        "regions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rect": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "[x, y, 幅, 高さ]（元の解像度のピクセル）"
                  },
                  "window": {
                    "type": "string"
                  },
                  "visible": {
                    "type": "boolean",
                    "description": "false でこの区割りを隠す（名前付きのレイアウト用）"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "画面の区割り"
        },
        "named": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "regions": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "rect": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "minItems": 4,
                          "maxItems": 4,
                          "description": "[x, y, 幅, 高さ]（元の解像度のピクセル）"
                        },
                        "window": {
                          "type": "string"
                        },
                        "visible": {
                          "type": "boolean",
                          "description": "false でこの区割りを隠す（名前付きのレイアウト用）"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "description": "名前付きのレイアウト"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "enum": [
              "select",
              "parser",
              "icon",
              "click"
            ]
          }
        },
        "parser_profile": {
          "type": "string"
        },
        "command_columns": {
          "type": "integer",
          "minimum": 1,
          "description": "コマンド選択の列の数（既定 2）"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "1秒あたりの文字数（0で一度に表示）"
        },
        "markup": {
          "type": "string"
        },
        "ruby": {
          "enum": [
            "above",
            "paren",
            "none"
          ]
        },
        "emphasis": {
          "enum": [
            "above",
            "paren",
            "none"
          ]
        },
        "color": {
          "type": "integer"
        },
        "name_color": {
          "type": "integer"
        },
        "denied_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "filters": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "default",
                "append",
                "replace",
                "none"
              ]
            },
            "list": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/filter"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filter"
          },
          "description": "配列で書くと replace と同じ"
        }
      ]
    },
    "transitions": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "named": {
          "type": "object"
        },
        "replace": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "description": "モダン機能の既定値の上書き"
    },
    "assets": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "window_skin": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "box",
                "nine_patch"
              ],
              "description": "box：パレットの色で枠線、nine_patch：9分割画像"
            },
            "border": {
              "type": "integer"
            },
            "pal": {
              "type": "integer"
            },
            "fill": {
              "type": "integer"
            },
            "image": {
              "type": "string"
            },
            "margins": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "additionalProperties": false
        },
        "cursor": {
          "type": "string"
        },
        "highlight": {
          "type": "integer"
        },
        "cursors": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "enum": [
                  "arrow",
                  "pointing_hand",
                  "cross",
                  "help",
                  "move",
                  "busy",
                  "ibeam",
                  "wait"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "hotspot": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "description": "マウスカーソルの形（種類 → OS標準の形か {image, hotspot}）"
        },
        "window_padding": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "窓の内側の余白 [横, 縦]（既定 [8, 4]）"
        },
        "ext": {
          "type": "object",
          "description": "拡張領域。中身は自由"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x\\.": {
          "description": "自作の項目（x.名前）"
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "拡張領域。中身は自由"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x\\.": {
      "description": "自作の項目（x.名前）"
    }
  },
  "required": [
    "template_version",
    "id"
  ],
  "definitions": {
    "font_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "description": "フォントの素材ID（font フォルダのファイル名）"
        },
        "size": {
          "type": "integer"
        },
        "line_height": {
          "type": "integer",
          "description": "行の高さ（省略時は size）"
        }
      }
    },
    "filter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "description": "フィルター（type と引数）",
          "properties": {
            "type": {
              "type": "string",
              "description": "scanline、reduce、dither、bleed、crt、rgb_mask、mono、lcd、aspect、または自作のID"
            },
            "intensity": {
              "type": "number"
            },
            "amount": {
              "type": "number"
            },
            "curvature": {
              "type": "number"
            },
            "vignette": {
              "type": "number"
            },
            "grid": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "bits": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dither": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
