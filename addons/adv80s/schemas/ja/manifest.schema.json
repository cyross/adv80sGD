{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/manifest.schema.json",
  "title": "adv80s 素材マニフェスト",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "type": "integer"
    },
    "generated": {
      "type": "boolean",
      "description": "自動生成されたマニフェストなら true"
    },
    "base": {
      "type": "string",
      "description": "ファイルの基準フォルダ（省略時はマニフェストのあるフォルダ）"
    },
    "assets": {
      "type": "object",
      "description": "ID（または 種類:ID）→ 素材",
      "patternProperties": {
        "^[^/]+$": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "image",
                "bgm",
                "se",
                "voice",
                "font",
                "shader",
                "video"
              ]
            },
            "file": {
              "type": "string",
              "description": "既定のファイル（base からの相対パス）"
            },
            "by_preset": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "variants": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "description": "機種別の差し替え（プリセットID、機種ID、グループID）"
            },
            "variants": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "差分（表情など）"
            },
            "pivot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "region": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "[x, y, 幅, 高さ]（元の解像度のピクセル）"
            },
            "loop_start": {
              "type": "number",
              "minimum": 0,
              "description": "ループの開始位置（秒）"
            },
            "volume": {
              "type": "number"
            },
            "color_key": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "透明にする色（\"#ff00ff\" かパレット番号）"
            },
            "grid": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "スプライトシートの切り方 [横の数, 縦の数]"
            },
            "anims": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "frames": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "fps": {
                    "type": "number"
                  },
                  "loop": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "description": "コマ送りアニメーション（名前 → frames、fps、loop）"
            },
            "hotspot": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "カーソル画像の指す位置"
            },
            "ext": {
              "type": "object",
              "description": "拡張領域。中身は自由"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x\\.": {
              "description": "自作の項目（x.名前）"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "manifest_version"
  ]
}
