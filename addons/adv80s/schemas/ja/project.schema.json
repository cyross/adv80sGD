{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/project.schema.json",
  "title": "adv80s プロジェクト設定",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project_version": {
      "type": "integer"
    },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "ゲームID。ほかのゲームと重ならない名前（セーブデータの見分けに使う）"
    },
    "title": {
      "type": "string",
      "description": "ゲームのタイトル（ウィンドウのタイトルにも使う）"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "enum": [
              "select",
              "parser",
              "icon",
              "click",
              "verb_click",
              "verb_cursor",
              "context"
            ]
          },
          "description": "使うコマンド方式。select=コマンド選択、parser=コマンド入力、icon=アイコン、click=絵のクリック、verb_click=動詞を選んで対象をクリック、verb_cursor=カーソルの動詞を切り替えてクリック、context=対象に合わせて自動で決める"
        },
        "parser_profile": {
          "type": "string"
        },
        "command_columns": {
          "type": "integer",
          "minimum": 1,
          "description": "コマンド選択の列の数（既定 2）"
        },
        "click_verb": {
          "type": "string",
          "description": "絵をクリックしたときの動詞（既定 EXAMINE）"
        },
        "item_verb": {
          "type": "string",
          "description": "持ち物をクリックして持ったときに使う動詞（既定 USE）"
        },
        "context_alt_verb": {
          "type": "string",
          "description": "右クリックで使う動詞（既定 LOOK）"
        },
        "context_verbs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "context で、カーソルの種類から決める動詞（種類 → 動詞ID。空は click_verb）"
        },
        "verb_cursors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "動詞に合わせるカーソルの種類（動詞ID → 種類）"
        }
      },
      "additionalProperties": false,
      "description": "コマンド方式。書いた項目だけ、テンプレートの inputs を上書きする"
    },
    "input_devices": {
      "type": "array",
      "items": {
        "enum": [
          "keyboard",
          "mouse",
          "gamepad",
          "touch"
        ]
      },
      "uniqueItems": true,
      "description": "使う入力機器（書かなければすべて）"
    },
    "template": {
      "type": "string",
      "description": "使う画面テンプレートのID"
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "登録するテンプレート"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "シナリオファイル（.ink.json は Ink のアダプタが読む）"
    },
    "ink": {
      "type": "object",
      "properties": {
        "sync_variables": {
          "type": "boolean",
          "description": "Ink の中で変わったグローバル変数を Core の状態に返す（既定 true）"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "string",
      "description": "開始シーン（空ならシナリオの start）"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "bool",
              "int",
              "float",
              "string"
            ]
          },
          "default": {}
        },
        "additionalProperties": false
      },
      "description": "全シナリオで共通の変数（名前 → {type, default}）"
    },
    "constants": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "integer",
          "number",
          "string"
        ]
      },
      "description": "全シナリオで共通の定数（名前 → 値。書き換えられない）"
    },
    "asset_roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "プロジェクトの素材フォルダ"
    },
    "asset_folders": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "image",
          "bgm",
          "se",
          "voice",
          "font",
          "shader",
          "video",
          null
        ]
      },
      "description": "種類フォルダの対応表への追加・変更（null で削除）"
    },
    "missing_asset": {
      "enum": [
        "placeholder",
        "error"
      ],
      "description": "見つからない素材の扱い"
    },
    "lang": {
      "enum": [
        "ja",
        "en"
      ]
    },
    "dictionaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verbs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "標準で使う動詞に足す拡張の動詞（GIVE、SHOW、PUSH、PULL、HIT、CALL、THINK、WAIT など）"
    },
    "slot_mode": {
      "enum": [
        "named",
        "standard"
      ]
    },
    "intent_schema": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "when": {
                "$ref": "#/definitions/condition"
              }
            },
            "additionalProperties": false,
            "required": [
              "file"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "event_defaults": {
      "type": "object",
      "description": "出力イベントの既定値（wait など）の書き換え",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "wait": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "click",
                  "end",
                  "input"
                ]
              },
              {
                "type": "number",
                "minimum": 0
              }
            ],
            "description": "次に進む条件。none、click、end、input、または秒数"
          },
          "log": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "message_log": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "hint": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "objective": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "hotspot": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "tried_marks": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "autosave": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "skip": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "auto_advance": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "rewind": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "flowchart": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "chapter_select": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "notebook": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "era_switch": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "readable_font": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "text_options": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "tts": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "gamepad": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "touch": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "filter_toggle": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x\\.": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "options": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "モダン機能（許可、既定値、細かい設定）"
    },
    "seed": {
      "type": "integer"
    },
    "hint_topics": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "ヒントの話題の表示名（話題 → 表示名）"
    },
    "transitions": {
      "type": "object",
      "properties": {
        "named": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "description": "名前付きの切り替え演出（名前 → 演出と引数）"
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "自作のフィルター・切り替え演出・画面効果の定義ファイル（*.effect.json）"
    },
    "save": {
      "type": "object",
      "properties": {
        "protection": {
          "enum": [
            "hmac",
            "hmac_aes",
            "none"
          ],
          "description": "保護レベル：hmac（検知のみ、標準）、hmac_aes（検知＋暗号化）、none"
        },
        "on_tamper": {
          "enum": [
            "reject",
            "warn"
          ],
          "description": "署名が一致しないとき：reject（読み込まない）、warn（警告して読み込む。暗号化時は不可）"
        },
        "text_format": {
          "type": "boolean",
          "description": "テキスト形式（JSON）で書き出す。製品版でも読み書きを許可する"
        },
        "dir": {
          "type": "string"
        },
        "slots": {
          "type": "integer",
          "minimum": 1
        },
        "key_provider": {
          "type": "string",
          "description": "embedded（標準）、per_user、または AdvKeyProvider を継承したスクリプトのパス"
        }
      },
      "additionalProperties": false,
      "description": "セーブの設定（第8章）"
    },
    "ext": {
      "type": "object",
      "description": "拡張領域。中身は自由"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x\\.": {
      "description": "自作の項目（x.名前）"
    }
  },
  "definitions": {
    "condition": {
      "description": "条件式（5.8）。JSONの形か、短い文字列の形（例：\"has_key and money >= 100\"）",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "description": "すべて満たす"
            },
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "description": "どれかを満たす"
            },
            "not": {
              "$ref": "#/definitions/condition",
              "description": "満たさない"
            },
            "var": {
              "type": "string",
              "description": "比べる変数"
            },
            "calc": {
              "type": "string",
              "description": "比べる計算式"
            },
            "count": {
              "type": "string",
              "description": "アイテムの個数"
            },
            "has": {
              "type": "string",
              "description": "アイテムを持っているか"
            },
            "scene": {
              "type": "string",
              "description": "現在のシーン"
            },
            "visited": {
              "type": "string",
              "description": "訪れたシーン"
            },
            "talked": {
              "type": "string",
              "description": "見た会話"
            },
            "read": {
              "type": "string",
              "description": "読んだ行"
            },
            "chosen": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[選択肢ID, 項目ID]"
            },
            "preset": {
              "type": "string",
              "description": "画面プリセット"
            },
            "group": {
              "type": "string",
              "description": "プリセットのグループ"
            },
            "feature": {
              "type": "string",
              "description": "有効なモダン機能"
            },
            "eq": {
              "description": "等しい"
            },
            "ne": {
              "description": "等しくない"
            },
            "lt": {
              "description": "未満"
            },
            "le": {
              "description": "以下"
            },
            "gt": {
              "description": "より大きい"
            },
            "ge": {
              "description": "以上"
            },
            "in": {
              "type": "array",
              "description": "いずれかと一致"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
