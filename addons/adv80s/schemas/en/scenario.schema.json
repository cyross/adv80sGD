{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/scenario.schema.json",
  "title": "adv80s scenario",
  "description": "JSON scenario (5.2, 5.7, 5.8)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "scenario_version": {
      "type": "integer"
    },
    "start": {
      "type": "string",
      "description": "Start scene ID"
    },
    "scene": {
      "type": "string",
      "description": "Scene ID for a single-scene file"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "variant": {
                    "type": "string"
                  },
                  "x": {
                    "type": "integer"
                  },
                  "y": {
                    "type": "integer"
                  },
                  "when": {
                    "$ref": "#/definitions/condition"
                  }
                }
              }
            ]
          }
        }
      ],
      "description": "Background image ID (or path). An array overlays the entries whose when holds"
    },
    "image_transition": {
      "description": "Transition when an image array changes (default cut)"
    },
    "first": {
      "$ref": "#/definitions/step",
      "description": "Steps on first visit"
    },
    "enter": {
      "$ref": "#/definitions/step",
      "description": "Steps on entering (after the first visit if first exists)"
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names recognized by the parser"
          },
          "label": {
            "type": "string",
            "description": "Label shown in command select"
          },
          "region": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, width, height] in native pixels"
          },
          "sprite": {
            "type": "string",
            "description": "Sprite ID whose visible area becomes the hotspot"
          },
          "cursor": {
            "type": "string",
            "description": "Cursor kind on hover"
          },
          "character": {
            "type": "string",
            "description": "Speaker ID when this is a character"
          },
          "when": {
            "$ref": "#/definitions/condition",
            "description": "Visible when"
          },
          "on": {
            "type": "object",
            "description": "Reaction per verb. \"USE+door\" narrows by the with target",
            "patternProperties": {
              "^[A-Z][A-Z0-9_]*(\\+[^+]+)?$": {
                "$ref": "#/definitions/step"
              }
            },
            "additionalProperties": false
          },
          "ext": {
            "type": "object",
            "description": "Extension area. Free-form"
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^x\\.": {
            "description": "Custom property (x.name)"
          }
        }
      },
      "description": "Objects and characters in the scene"
    },
    "exits": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "properties": {
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "label": {
                "type": "string"
              },
              "when": {
                "$ref": "#/definitions/condition"
              },
              "on": {
                "type": "object",
                "description": "Reaction per verb. \"USE+door\" narrows by the with target",
                "patternProperties": {
                  "^[A-Z][A-Z0-9_]*(\\+[^+]+)?$": {
                    "$ref": "#/definitions/step"
                  }
                },
                "additionalProperties": false
              },
              "region": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "[x, y, width, height] in native pixels"
              },
              "sprite": {
                "type": "string"
              },
              "cursor": {
                "type": "string"
              },
              "ext": {
                "type": "object",
                "description": "Extension area. Free-form"
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^x\\.": {
                "description": "Custom property (x.name)"
              }
            }
          }
        ]
      },
      "description": "Exits (target scene ID -> settings)"
    },
    "sprites": {
      "type": "array",
      "description": "Sprites placed in the scene (shown while when holds)",
      "items": {
        "type": "object",
        "required": [
          "id",
          "image"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "anchor": {
            "type": "string"
          },
          "z": {
            "type": "integer"
          },
          "scale": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "rotation": {
            "type": "number"
          },
          "opacity": {
            "type": "number"
          },
          "flip": {
            "type": "string"
          },
          "blend": {
            "enum": [
              "normal",
              "add",
              "multiply"
            ]
          },
          "tint": {
            "type": "string"
          },
          "smooth": {
            "type": "boolean"
          },
          "color_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "anim": {
            "type": [
              "string",
              "null"
            ]
          },
          "when": {
            "$ref": "#/definitions/condition"
          },
          "show": {
            "description": "Transition when shown"
          },
          "hide": {
            "description": "Transition when hidden"
          }
        },
        "additionalProperties": false
      }
    },
    "on": {
      "type": "object",
      "description": "Reaction per verb. \"USE+door\" narrows by the with target",
      "patternProperties": {
        "^[A-Z][A-Z0-9_]*(\\+[^+]+)?$": {
