  "definitions": {
    "condition": {
      "description": "Condition (5.8). JSON form or short string form (e.g. \"has_key and money >= 100\")",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "description": "All must hold"
            },
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/condition"
              },
              "description": "Any must hold"
            },
            "not": {
              "$ref": "#/definitions/condition",
              "description": "Must not hold"
            },
            "var": {
              "type": "string",
              "description": "Variable to compare"
            },
            "calc": {
              "type": "string",
              "description": "Expression to compare"
            },
            "count": {
              "type": "string",
              "description": "Item count"
            },
            "has": {
              "type": "string",
              "description": "Has the item"
            },
            "scene": {
              "type": "string",
              "description": "Current scene"
            },
            "visited": {
              "type": "string",
              "description": "Visited scene"
            },
            "talked": {
              "type": "string",
              "description": "Seen dialogue"
            },
            "read": {
              "type": "string",
              "description": "Read line"
            },
            "chosen": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[choice ID, option ID]"
            },
            "preset": {
              "type": "string",
              "description": "Screen preset"
            },
            "group": {
              "type": "string",
              "description": "Preset group"
            },
            "feature": {
              "type": "string",
              "description": "Enabled modern feature"
            },
            "eq": {
              "description": "Equal"
            },
            "ne": {
              "description": "Not equal"
            },
            "lt": {
              "description": "Less than"
            },
            "le": {
              "description": "Less or equal"
            },
            "gt": {
              "description": "Greater than"
            },
