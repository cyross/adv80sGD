{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/manifest.schema.json",
  "title": "adv80s asset manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "type": "integer"
    },
    "generated": {
      "type": "boolean",
      "description": "true for generated manifests"
    },
    "base": {
      "type": "string",
      "description": "Base folder (defaults to the manifest folder)"
    },
    "assets": {
      "type": "object",
      "description": "ID (or kind:ID) -> asset",
      "patternProperties": {
        "^[^/]+$": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "image",
                "bgm",
                "se",
                "voice",
                "font",
                "shader",
                "video"
              ]
            },
            "file": {
              "type": "string",
              "description": "Default file (relative to base)"
            },
            "by_preset": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "variants": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "description": "Per-preset overrides (preset, machine or group ID)"
            },
            "variants": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Variants (expressions, etc.)"
            },
            "pivot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "region": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "[x, y, width, height] in native pixels"
            },
            "loop_start": {
              "type": "number",
              "minimum": 0,
              "description": "Loop start (seconds)"
            },
            "volume": {
              "type": "number"
            },
            "color_key": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "Color made transparent (\"#ff00ff\" or palette index)"
            },
            "grid": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Sprite sheet grid [columns, rows]"
            },
            "anims": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "frames": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "fps": {
                    "type": "number"
                  },
                  "loop": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "description": "Frame animations (name -> frames, fps, loop)"
            },
            "hotspot": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Cursor image hotspot"
            },
            "alt": {
              "type": "string",
              "description": "Text used for the image as gaiji ([gaiji=ID]) in the message log and speech"
            },
            "keep_colors": {
              "type": "boolean",
              "description": "Keep the image's own colours: when shown as gaiji ([gaiji=ID]), skip the colour-reduction filter (default false; scanlines etc. still apply)"
            },
            "ext": {
              "type": "object",
              "description": "Extension area. Free-form"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x\\.": {
              "description": "Custom property (x.name)"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "manifest_version"
  ]
}
