{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/template.schema.json",
  "title": "adv80s screen template",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "template_version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "description": "Template ID"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parent template ID"
    },
    "display": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "description": "Screen preset (machine ID or machine.mode)"
        },
        "scale": {
          "enum": [
            "integer",
            "fit",
            "none"
          ]
        },
        "aspect_correction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "preset",
            "colors"
          ]
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#?[0-9a-fA-F]{6}$"
          }
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/definitions/font_entry"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/definitions/font_entry"
            },
            "minItems": 1
          }
        ]
      },
      "description": "Fonts (main, readable). With an array of candidates, the first one found is used"
    },
    "layout": {
      "type": "object",
      "properties": {
        "background": {
          "type": "integer",
          "description": "Background palette index"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Image layers (back to front)"
        },
        "screen_layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Screen-space sprite layers; names starting with back are behind the picture, others in front of windows"
        },
        "regions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rect": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "[x, y, width, height] in native pixels"
                  },
                  "window": {
                    "type": "string"
                  },
                  "visible": {
                    "type": "boolean",
                    "description": "false hides this region (for named layouts)"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Screen regions"
        },
        "named": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "regions": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "rect": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "minItems": 4,
                          "maxItems": 4,
                          "description": "[x, y, width, height] in native pixels"
                        },
                        "window": {
                          "type": "string"
                        },
                        "visible": {
                          "type": "boolean",
                          "description": "false hides this region (for named layouts)"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "description": "Named layouts"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "enum": [
              "select",
              "parser",
              "icon",
              "click",
              "verb_click",
              "verb_cursor",
              "context"
            ]
          },
          "description": "Command methods. select, parser, icon, click, verb_click (pick a verb, then click a target), verb_cursor (cycle the cursor verb, then click), context (verb chosen from the target)"
        },
        "parser_profile": {
          "type": "string",
          "description": "How typed commands are read. ja (Japanese, default), en (English), free (free sentences), or a parser script path"
        },
        "command_columns": {
          "type": "integer",
          "minimum": 1,
          "description": "Columns of the command list (default 2)"
        },
        "click_verb": {
          "type": "string",
          "description": "Verb used when the picture is clicked (default EXAMINE)"
        },
        "item_verb": {
          "type": "string",
          "description": "Verb used when an inventory item is picked up by clicking (default USE)"
        },
        "context_alt_verb": {
          "type": "string",
          "description": "Verb used on right click (default LOOK)"
        },
        "context_verbs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "For context: verb per cursor kind (kind -> verb ID; empty = click_verb)"
        },
        "verb_cursors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Cursor kind per verb (verb ID -> kind)"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "Characters per second (0 = instant)"
        },
        "markup": {
          "type": "string"
        },
        "ruby": {
          "enum": [
            "above",
            "paren",
            "none"
          ]
        },
        "emphasis": {
          "enum": [
            "above",
            "paren",
            "none"
          ]
        },
        "color": {
          "type": "integer"
        },
        "name_color": {
          "type": "integer"
        },
        "denied_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "filters": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "default",
                "append",
                "replace",
                "none"
              ]
            },
            "list": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/filter"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filter"
          },
          "description": "An array means replace"
        }
      ]
    },
    "transitions": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "named": {
          "type": "object"
        },
        "replace": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "description": "Override modern feature defaults"
    },
    "assets": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "window_skin": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "box",
                "nine_patch"
              ],
              "description": "box: palette border, nine_patch: 9-slice image"
            },
            "border": {
              "type": "integer"
            },
            "pal": {
              "type": "integer"
            },
            "fill": {
              "type": "integer"
            },
            "image": {
              "type": "string"
            },
            "margins": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "additionalProperties": false
        },
        "cursor": {
          "type": "string"
        },
        "highlight": {
          "type": "integer"
        },
        "cursors": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "enum": [
                  "arrow",
                  "pointing_hand",
                  "cross",
                  "help",
                  "move",
                  "busy",
                  "ibeam",
                  "wait"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "hotspot": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "description": "Mouse cursor shapes (kind -> OS shape or {image, hotspot})"
        },
        "wait_mark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "anim": {
                  "type": "string"
                },
                "blink": {
                  "type": "boolean"
                },
                "color_key": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "offset": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Click-wait marker (text or {text|image, anim, blink, offset}; default blinking ▼)"
        },
        "page_mark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "anim": {
                  "type": "string"
                },
                "blink": {
                  "type": "boolean"
                },
                "color_key": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "offset": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "Page-turn marker (same format as wait_mark; defaults to wait_mark)"
        },
        "window_padding": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Inner padding of windows [x, y] (default [8, 4])"
        },
        "ext": {
          "type": "object",
          "description": "Extension area. Free-form"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x\\.": {
          "description": "Custom property (x.name)"
        }
      }
    },
    "notice": {
      "$ref": "#/definitions/notice_style"
    },
    "ext": {
      "type": "object",
      "description": "Extension area. Free-form"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x\\.": {
      "description": "Custom property (x.name)"
    }
  },
  "required": [
    "template_version",
    "id"
  ],
  "definitions": {
    "notice_style": {
      "type": "object",
      "properties": {
        "position": {
          "enum": [
            "top_right",
            "top_left",
            "bottom_right",
            "bottom_left",
            "top",
            "bottom",
            "center"
          ],
          "description": "Position (default top_right)"
        },
        "fg": {
          "type": "integer",
          "description": "Text color (palette index, default 7)"
        },
        "bg": {
          "type": "integer",
          "description": "Background color (default 0)"
        },
        "border": {
          "type": "integer",
          "description": "Border color (default 7; -1 = none)"
        },
        "se": {
          "type": "string",
          "description": "Sound effect when shown (asset ID)"
        },
        "seconds": {
          "type": "number",
          "description": "Seconds shown (default 2.5; 0 = until clicked)"
        },
        "click_close": {
          "type": "boolean",
          "description": "Click to dismiss (default true)"
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "description": "Max notices at once (default 5; oldest removed; 0 = no limit)"
        },
        "overflow": {
          "enum": [
            "instant",
            "fade"
          ],
          "description": "How notices over the limit disappear (instant (default) or fade)"
        },
        "log_labels": {
          "type": "object",
          "properties": {
            "all": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "notice": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Labels of the log screen filter"
        },
        "log_filter": {
          "enum": [
            "all",
            "text",
            "notice"
          ],
          "description": "What the log screen shows first"
        },
        "log_mark": {
          "type": "string",
          "description": "Mark before notices in the message log (default ◆)"
        },
        "log_color": {
          "type": "integer",
          "description": "Notice color in the message log (palette index)"
        },
        "margin": {
          "type": "number",
          "description": "Margin from the screen edge (default 12)"
        },
        "icon_size": {
          "type": "number",
          "description": "Icon size (default 24)"
        },
        "log": {
          "type": "boolean",
          "description": "Also add notices to the message log (default false)"
        }
      },
      "additionalProperties": false,
      "description": "Notice appearance"
    },
    "font_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "description": "Font asset ID (file name in the font folder)"
        },
        "size": {
          "type": "integer"
        },
        "line_height": {
          "type": "integer",
          "description": "Line height (defaults to size)"
        }
      }
    },
    "filter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "description": "Filter (type and arguments)",
          "properties": {
            "type": {
              "type": "string",
              "description": "scanline, reduce, dither, bleed, crt, rgb_mask, mono, lcd, aspect, or a custom ID"
            },
            "intensity": {
              "type": "number"
            },
            "amount": {
              "type": "number"
            },
            "curvature": {
              "type": "number"
            },
            "vignette": {
              "type": "number"
            },
            "grid": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "bits": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dither": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
