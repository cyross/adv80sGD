{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adv80s/template.schema.json",
  "title": "adv80s screen template",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "template_version": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "description": "Template ID"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parent template ID"
    },
    "display": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "description": "Screen preset (machine ID or machine.mode)"
        },
        "scale": {
          "enum": [
            "integer",
            "fit",
            "none"
          ]
        },
        "aspect_correction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "preset",
            "colors"
          ]
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#?[0-9a-fA-F]{6}$"
          }
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/definitions/font_entry"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/definitions/font_entry"
            },
            "minItems": 1
          }
        ]
      },
      "description": "Fonts (main, readable). With an array of candidates, the first one found is used"
    },
    "layout": {
      "type": "object",
      "properties": {
        "background": {
          "type": "integer",
          "description": "Background palette index"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Image layers (back to front)"
        },
        "regions": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rect": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "[x, y, width, height] in native pixels"
                  },
                  "window": {
                    "type": "string"
                  },
                  "visible": {
                    "type": "boolean",
                    "description": "false hides this region (for named layouts)"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Screen regions"
        },
        "named": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "regions": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "rect": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "minItems": 4,
                          "maxItems": 4,
                          "description": "[x, y, width, height] in native pixels"
                        },
                        "window": {
                          "type": "string"
                        },
                        "visible": {
                          "type": "boolean",
                          "description": "false hides this region (for named layouts)"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "description": "Named layouts"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "enum": [
              "select",
              "parser",
              "icon",
              "click"
            ]
          }
        },
        "parser_profile": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "Characters per second (0 = instant)"
        },
        "markup": {
          "type": "string"
        },
        "ruby": {
          "enum": [
            "above",
            "paren",
            "none"
          ]
        },
        "emphasis": {
          "enum": [
            "above",
            "paren",
            "none"
          ]
        },
        "color": {
          "type": "integer"
        },
        "name_color": {
          "type": "integer"
        },
        "denied_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "filters": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "default",
                "append",
                "replace",
                "none"
              ]
            },
            "list": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/filter"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/filter"
          },
          "description": "An array means replace"
        }
      ]
    },
    "transitions": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "named": {
          "type": "object"
        },
        "replace": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "description": "Override modern feature defaults"
    },
    "assets": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "window_skin": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "box",
                "nine_patch"
              ],
              "description": "box: palette border, nine_patch: 9-slice image"
            },
            "border": {
              "type": "integer"
            },
            "pal": {
              "type": "integer"
            },
            "fill": {
              "type": "integer"
            },
            "image": {
              "type": "string"
            },
            "margins": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "additionalProperties": false
        },
        "cursor": {
          "type": "string"
        },
        "highlight": {
          "type": "integer"
        },
        "ext": {
          "type": "object",
          "description": "Extension area. Free-form"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x\\.": {
          "description": "Custom property (x.name)"
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Extension area. Free-form"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x\\.": {
      "description": "Custom property (x.name)"
    }
  },
  "required": [
    "template_version",
    "id"
  ],
  "definitions": {
    "font_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "description": "Font asset ID (file name in the font folder)"
        },
        "size": {
          "type": "integer"
        },
        "line_height": {
          "type": "integer",
          "description": "Line height (defaults to size)"
        }
      }
    },
    "filter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "description": "Filter (type and arguments)",
          "properties": {
            "type": {
              "type": "string",
              "description": "scanline, reduce, dither, bleed, crt, rgb_mask, mono, lcd, aspect, or a custom ID"
            },
            "intensity": {
              "type": "number"
            },
            "amount": {
              "type": "number"
            },
            "curvature": {
              "type": "number"
            },
            "vignette": {
              "type": "number"
            },
            "grid": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "bits": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dither": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
