#!/usr/bin/env python
# adv80s_mp4 のビルド（段階70）。native/adv80s_mp4 で：
#   scons platform=windows target=template_release
# できた DLL は addons/adv80s_mp4/bin に置かれる（エディタでも書き出したゲームでも、これ一つを使う）。

env = SConscript("../godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

if env["platform"] == "windows":
    env.Append(LIBS=["mfplat", "mfreadwrite", "mfuuid", "ole32", "delayimp"])
    # Media Foundation のない Windows（N エディション）でも DLL を読めるように、使うときに読む
    env.Append(LINKFLAGS=["/DELAYLOAD:mfplat.dll", "/DELAYLOAD:mfreadwrite.dll"])

library = env.SharedLibrary(
    "../../addons/adv80s_mp4/bin/adv80s_mp4{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
env.NoCache(library)
Default(library)
